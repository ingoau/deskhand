{
  "name": "@deskhand/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "deskhand control daemon: runs inside each desktop container (XTEST input, screenshots, lock, exec, files, ui-tree, CDP and VNC proxies)",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@deskhand/shared": "workspace:*",
    "sharp": "0.35.5",
    "ws": "^8.22.0",
    "x11": "4.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
